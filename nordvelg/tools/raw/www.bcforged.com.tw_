<script>
	$("body").addClass("is-lock")
	var _tl = gsap.timeline({
		// paused: false
	}).to(".stopWrap .wheel-area", {
		duration: 6,
		rotation: -380,
		ease: 'none',
	}).to(".stopWrap .wheel-area .one", {
		duration: 1,
		opacity: 0,
		ease: 'none',
	}, "<").to(".stopWrap .wheel-area .two", {
		duration: 1,
		opacity: 1,
		ease: 'none',
	}, "<").to(".stopWrap .wheel-area .two", {
		duration: 1,
		opacity: 0,
		ease: 'none',
	}).to(".stopWrap .wheel-area .three", {
		duration: 1,
		opacity: 1,
		ease: 'none',
	}, "<")


	ScrollTrigger.create({
		trigger: ".stopWrap .wheel-area",
		toggleActions: "play pause resume reverse", //重覆觸發
		start: "center 50%",
		endTrigger: ".qualityWrap",
		end: "center 50%",
		pin: true,
		scrub: 1,
		// markers: true,
		animation: _tl
	});


	$(".qualitt-next-scroll").on("click", function() {
		TweenMax.to(window, 1.2, {
			scrollTo: {
				y: ".index-newsWrap",
				offsetY: 100
			},
			ease: 'power2.inOut',
		});
	})

	$(".fancy-close-btn, .fancy-close-block").on("click", function() {
		$(".m-fancyWrap").removeClass("is-show")
		gsap.delayedCall(0.5, function() {
			$("body").removeClass("is-lock")
		});
	})
	$(".go-to-racing-area").on("click", function() {
		window.location.href="https://bcracing.com.tw/"
	})
</script>