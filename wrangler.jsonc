{
  "name": "jukamedia",
  "compatibility_date": "2026-07-12",
  "workers_dev": true,
  "main": "worker.js",
  "routes": [
    { "pattern": "jukamedia.com", "custom_domain": true },
    { "pattern": "www.jukamedia.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
