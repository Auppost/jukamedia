<body>

    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5DZ8L9P" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
	<!-- End Google Tag Manager (noscript) -->

<div class="login_page_wrap">

                <style>
            @media screen and (max-width: 768px) {
                #login_left{
                    display: none !important;
                }
                #login_right{
                    margin-top: 0px !important;
                    padding-top: 50px !important;

                    & img{
                        display: block !important;
                        margin:0 auto !important;
                    }
                }
            }
        </style>
   
    <div class="login_left" style="display: flex;justify-content: center;align-items: center;" id="login_left">
        <img src="https://cdn.berlintires.shop/banners/b2b-shop-mainz05-sponsorship.png" alt="campaign banner" style="width: 100%; height: 100%; object-fit: contain; display: block;">
            </div>
    <div class="login_right" id="login_right">
        <div class="login_right_inner">           
            <img src="https://cdn.berlintires.shop/logos/logo.svg" class="logo" alt="Berlin Tires" width="340" height="70">
            <div class="reset_password_infos"></div>
            <div class="login_inner">
                <form name="loginform" id="loginform" action="https://berlintires.shop/wp-login.php" method="post"><p class="login-username">
				<label for="user_login">Username or Email Address</label>
				<input type="text" name="log" id="user_login" autocomplete="username" class="input" value="" size="20" />
			</p><p class="login-password">
				<label for="user_pass">Password</label>
				<input type="password" name="pwd" id="user_pass" autocomplete="current-password" spellcheck="false" class="input" value="" size="20" />
			</p><p class="login-remember"><label><input name="rememberme" type="checkbox" id="rememberme" value="forever" checked="checked" /> Remember Me</label></p><p class="login-submit">
				<input type="submit" name="wp-submit" id="wp-submit" class="button button-primary" value="Log In" />
				<input type="hidden" name="redirect_to" value="https://berlintires.shop" />
			</p></form>                <div class="register">
                    <span style="text-align: center;">Don't have an account?</span>
                    <a href="https://zfrmz.com/7fRs4QLeuz1CQXJSXQK3?zf_lang=de" class="button register_button">                        
                        Register                    </a>
                </div>
            </div>

            <div class="get_new_pass_inner">
                <h4>Did you forget your password?</h4>
                <p>Please enter your username or email address. You will receive a link via email with which you can create a new password.</p>
                                <form method="post" class="resend_password_form">
                    <div class="forgot_pwd_form">
                        <div class="log_user">
                            <label for="user_or_email">Username or E-mail address</label>
                            <input type="text" name="user_or_email" id="user_or_email" value="" />
                        </div>
                        <div class="log_user" style="margin-top: -15px;">
                                                        <input type="hidden" id="reset_pass_nonce" name="reset_pass_nonce" value="2c5bf80fb8" /><input type="hidden" name="_wp_http_referer" value="/login/" />                            <button type="submit" class="get_new_password">Reset Password</button>
                            <div style="text-align: center; margin: 1em auto 0;"><a href="#" class="get_new_pass_red_to_login">Log in</a></div>
                        </div>
                    </div>
                </form>

            </div>

            <img src="https://cdn.berlintires.shop/theme/login/brands.webp" class="login_brands" alt="Brands" width="448" height="60">
            <div class="copyright">© 2026 BERLIN TIRES EUROPA GMBH</div>
        </div>

    </div>
</div>
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script>
    (function($) {
        var ajaxUrl = 'https://berlintires.shop/wp-admin/admin-ajax.php';

        $('p.login-password').append('<div class="show_pass"><img src="https://cdn.berlintires.shop/theme/login/eye.webp"/ alt="eye" width="20" height="16"></div>');
        $('label[for="user_pass"]').append('<a href="#forgot_pass" class="forgot_pass">Forgot Password?</a>');

        $(document).on('click', '.show_pass', function(){
            $('input#user_pass').attr('type', 'text');
            $(this).removeClass('show_pass');
            $(this).addClass('dont_show_pass');
        });
        $(document).on('click', '.dont_show_pass', function(){
            $('input#user_pass').attr('type', 'password');
            $(this).removeClass('dont_show_pass');
            $(this).addClass('show_pass');
        });
        $(document).on('click', 'a.forgot_pass', function(e){
            e.preventDefault();
            $('.login_inner').hide();
            $('.get_new_pass_inner').fadeIn();
            return false;
        });
        $(document).on('click', 'a.get_new_pass_red_to_login', function(e){
            e.preventDefault();
            $('.reset_password_infos').html('');
            $('.get_new_pass_inner').hide();
            $('.login_inner').fadeIn();
            return false;
        });
        $('form.resend_password_form').submit(function(e) {
            e.preventDefault();
            $('.reset_password_infos').html('');
            var data = {
                action: 'partner_reset_password',
                reset_pass_nonce: $('input#reset_pass_nonce').val(),
                user_login: $('.forgot_pwd_form input#user_or_email').val()
            }
            $.post(ajaxUrl, data, function(response){
                var res = JSON.parse(response);
                
                if(res.error && res.error!=''){
                    $('.reset_password_infos').html('<div class="info_box fail">'+res.error+'</div>');
                }
                if(res.success && res.success!=''){
                    $('.reset_password_infos').html('<div class="info_box success">'+res.success+'</div>');
                }

            });
            return false;
        });

        let loginSubmitting = false;
        $('form#loginform').on('submit', function(e){
            if (loginSubmitting) {
                e.preventDefault();
                return;
            }

            loginSubmitting = true;
            $(this).attr('aria-busy', 'true');
            $(this).find('input#wp-submit').prop('disabled', true);
        });

        $(window).on('pageshow', function(){
            loginSubmitting = false;
            $('form#loginform').removeAttr('aria-busy');
            $('form#loginform input#wp-submit').prop('disabled', false);
        });
    })(jQuery);
</script>

</body>
</html>